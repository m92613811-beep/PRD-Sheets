<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        h1 { color: #333; }
        .back { margin-bottom: 20px; }
        .back a { text-decoration: none; color: #007bff; }
        .reports { margin-top: 20px; }
        .report-item { padding: 10px; border: 1px solid #ddd; margin-bottom: 10px; }
    </style>
</head>
<body>
    <div class="back"><a href="/">← Back to Dashboard</a></div>
    <h1><%= title %></h1>
    <div class="reports">
        <p>Generate and view reports here.</p>
        <div class="report-item">
            <h3>Sample Report 1</h3>
            <p>This is a placeholder for a report.</p>
        </div>
        <div class="report-item">
            <h3>Sample Report 2</h3>
            <p>Another placeholder report.</p>
        </div>
    </div>
</body>
</html>