<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRD Dashboard</title>
    <style>
        /* RESET & BASE STYLES */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        body {
            background-color: #f9fbf9;
            color: #333;
        }

        /* HEADER */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 30px;
            background: #0b3d2e; /* PRD dark green */
            color: white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.2rem;
            font-weight: bold;
        }

        .search {
            width: 40%;
            padding: 10px 15px;
            border-radius: 20px;
            border: none;
            outline: none;
        }

        .profile {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: orange;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            cursor: pointer;
        }

        .auth {
            display: flex; gap: 10px;
        }

        .auth button {
            padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer;
        }

        #loginBtn { background: #007bff; color: white; }
        #signupBtn { background: #28a745; color: white; }

        /* Modal Styles */
        .modal {
            display: none; position: fixed; z-index: 1; left: 0; top: 0; width: 100%; height: 100%;
            background-color: rgba(0,0,0,0.4);
        }

        .modal-content {
            background-color: #fefefe; margin: 15% auto; padding: 20px; border: 1px solid #888; width: 80%; max-width: 400px;
            border-radius: 8px;
        }

        .close {
            color: #aaa; float: right; font-size: 28px; font-weight: bold; cursor: pointer;
        }

        .close:hover { color: black; }

        .modal form { display: flex; flex-direction: column; }

        .modal input { margin: 10px 0; padding: 10px; }

        .modal button { padding: 10px; background: #007bff; color: white; border: none; cursor: pointer; margin-top: 10px; }

        .modal .signup-btn { background: #28a745; }

        /* MAIN CONTENT */
        main {
            padding: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

        h2 {
            margin-bottom: 20px;
            font-size: 1.1rem;
            color: #555;
        }

        /* TEMPLATE SECTION (Responsive Grid) */
        .templates {
            margin-bottom: 40px;
        }

        .card-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 20px;
        }

        .card {
            height: 110px;
            background: white;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .card:hover {
            background: #e8f5e9;
            border-color: #2e7d32;
            transform: translateY(-2px);
        }

        .card.plus {
            font-size: 2.5rem;
            color: #2e7d32;
            background: #fff;
        }

        /* FILES SECTION & TABLE */
        .table-container {
            background: white;
            border-radius: 8px;
            border: 1px solid #eee;
            overflow-x: auto; /* Makes table scrollable on small screens */
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 600px;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #f0f0f0;
        }

        th {
            background-color: #f8f9fa;
            color: #777;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
        }

        tr:hover {
            background-color: #f1f8f1;
        }

        /* MOBILE RESPONSIVENESS */
        @media (max-width: 768px) {
            .header {
                padding: 15px;
            }
            .search {
                width: 50%;
            }
            .card-container {
                grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            }
        }

        @media (max-width: 480px) {
            .header {
                flex-direction: column;
                gap: 15px;
            }
            .search {
                width: 100%;
            }
        }
    </style>
</head>
<body>

<header class="header">
    <div class="logo">
        <div style="background: white; width: 30px; height: 30px; border-radius: 4px;"></div>
        <span>PRD Sheets</span>
    </div>

    <input type="text" placeholder="Search your files..." class="search" id="fileSearch">

    <div class="auth">
        <button id="loginBtn">Login</button>
        <button id="signupBtn">Sign Up</button>
    </div>
</header>

<main>

    <section class="templates">
        <h2>Start a new spreadsheet</h2>

        <div class="card-container">
            <div class="card plus" id="addFileCard">+</div>
            <a href="/task" class="card">Task List</a>
            <a href="/budget" class="card">Budget</a>
            <a href="/analytics" class="card">Analytics</a>
            <a href="/reports" class="card">Reports</a>
        </div>

        <!-- Add File Form -->
        <div id="addFileForm" style="display: none; margin-top: 20px; padding: 20px; border: 1px solid #ddd; border-radius: 8px; background: #f9f9f9;">
            <h3>Add New File</h3>
            <input type="text" id="fileName" placeholder="File Name" required style="margin: 10px 0; padding: 8px; width: 100%; box-sizing: border-box;">
            <input type="text" id="fileOwner" placeholder="Owner" required style="margin: 10px 0; padding: 8px; width: 100%; box-sizing: border-box;">
            <button id="submitFile" style="padding: 10px 20px; background: #2e7d32; color: white; border: none; border-radius: 4px; cursor: pointer;">Add File</button>
            <button id="cancelAdd" style="padding: 10px 20px; background: #ccc; color: black; border: none; border-radius: 4px; cursor: pointer; margin-left: 10px;">Cancel</button>
        </div>
    </section>

    <section class="files">
        <h2>Recent Files</h2>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Owner</th>
                        <th>Last Modified</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="fileTable">
                    <% if (typeof files !== 'undefined' && files.length > 0) { %>
                        <% files.forEach(file => { %>
                            <tr>
                                <td><strong><%= file.name %></strong></td>
                                <td><%= file.owner %></td>
                                <td><%= file.date %></td>
                                <td><button class="delete-btn" data-id="<%= file.id %>" style="padding: 5px 10px; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;">Delete</button></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 30px; color: #999;">
                                No recent files found.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

</main>

<!-- Login Modal -->
<div id="loginModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal('loginModal')">&times;</span>
        <h2>Login</h2>
        <form id="loginForm">
            <input type="email" id="loginEmail" placeholder="Email" required>
            <input type="password" id="loginPassword" placeholder="Password" required>
            <button type="submit">Login</button>
        </form>
    </div>
</div>

<!-- Signup Modal -->
<div id="signupModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal('signupModal')">&times;</span>
        <h2>Sign Up</h2>
        <form id="signupForm">
            <input type="text" id="signupName" placeholder="Full Name" required>
            <input type="email" id="signupEmail" placeholder="Email" required>
            <input type="password" id="signupPassword" placeholder="Password" required>
            <button type="submit" class="signup-btn">Sign Up</button>
        </form>
    </div>
</div>

<script>
    // Handle add file form
    const addFileCard = document.getElementById('addFileCard');
    const addFileForm = document.getElementById('addFileForm');
    const submitFile = document.getElementById('submitFile');
    const cancelAdd = document.getElementById('cancelAdd');
    const fileName = document.getElementById('fileName');
    const fileOwner = document.getElementById('fileOwner');

    addFileCard.addEventListener('click', () => {
        addFileForm.style.display = 'block';
    });

    cancelAdd.addEventListener('click', () => {
        addFileForm.style.display = 'none';
        fileName.value = '';
        fileOwner.value = '';
    });

    submitFile.addEventListener('click', async () => {
        const name = fileName.value.trim();
        const owner = fileOwner.value.trim();
        if (!name || !owner) {
            alert('Please fill in both fields');
            return;
        }

        try {
            const response = await fetch('/api/files', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ name, owner })
            });

            if (response.ok) {
                // Reload the page to show the new file
                window.location.reload();
            } else {
                alert('Error adding file');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error adding file');
        }
    });

    // Handle delete
    document.addEventListener('click', async (e) => {
        if (e.target.classList.contains('delete-btn')) {
            const id = e.target.dataset.id;
            if (confirm('Are you sure you want to delete this file?')) {
                try {
                    const response = await fetch(`/api/files/${id}`, {
                        method: 'DELETE'
                    });

                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Error deleting file');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Error deleting file');
                }
            }
        }
    });

    // Handle auth buttons
    document.getElementById('loginBtn').addEventListener('click', () => {
        document.getElementById('loginModal').style.display = 'block';
    });

    document.getElementById('signupBtn').addEventListener('click', () => {
        document.getElementById('signupModal').style.display = 'block';
    });

    // Close modal function
    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }

    // Close modal when clicking outside
    window.onclick = function(event) {
        if (event.target.classList.contains('modal')) {
            event.target.style.display = 'none';
        }
    }

    // Handle login form
    document.getElementById('loginForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const email = document.getElementById('loginEmail').value;
        const password = document.getElementById('loginPassword').value;
        // Placeholder: In real app, send to server
        alert(`Login successful for ${email}!`);
        closeModal('loginModal');
    });

    // Handle signup form
    document.getElementById('signupForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('signupName').value;
        const email = document.getElementById('signupEmail').value;
        const password = document.getElementById('signupPassword').value;
        // Placeholder: In real app, send to server
        alert(`Sign up successful for ${name}!`);
        closeModal('signupModal');
    });
</script>

</body>
</html>